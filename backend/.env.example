NODE_ENV=development
PORT=3001
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=omnicloud_auth

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Each app user chooses an AWS IAM Identity Center profile from this backend's
# AWS config. OmniCloud creates a distinct SSO session/cache per app user.
AWS_LOCAL_PROFILE_MODE_ENABLED=true
AWS_LOCAL_PROFILE=omnicloud-dev
AWS_REGION=us-east-1
# Optional portal fallback when no AWS SSO profile exists in ~/.aws/config.
AWS_SSO_START_URL=
AWS_SSO_REGION=
# Optional: persist per-user generated AWS config outside the backend folder.
OMNICLOUD_AWS_USER_CONFIG_DIR=

# OmniCloud's Google Cloud workload identity service account (no JSON key file).
# Grant this principal roles/iam.serviceAccountTokenCreator on each customer SA.
OMNICLOUD_GCP_SERVICE_ACCOUNT_EMAIL=omnicloudofficial@gmail.com

# Azure Lighthouse managing tenant and the service principal object ID authorized
# in each customer delegation. These are OmniCloud identity IDs, never customer keys.

# Use cli for local development; use managed_identity, service_principal, or oidc
# for deployment hosts. Any ARM_* secret/token belongs only to OmniCloud's backend.
OMNICLOUD_AZURE_AUTH_MODE=cli
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_OIDC_TOKEN=
AZURE_CLI_BIN=az

# AWS CLI profile settings must exist on this backend host; no AWS keys go here.

# Optional overrides. Terraform must be installed and on PATH if TERRAFORM_BIN is blank.
TERRAFORM_BIN=
TERRAFORM_STATE_DIR=
TERRAFORM_PLUGIN_CACHE_DIR=
